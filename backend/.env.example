# =================================================
# INTEGRABRIDGE - BACKEND ENVIRONMENT VARIABLES
# =================================================
# 
# ⚠️  IMPORTANTE: 
# Este é um arquivo de EXEMPLO. Nunca commite valores reais!
# Copie este arquivo para .env e substitua pelos valores reais.
#
# Para obter suas credenciais:
# 1. Acesse https://supabase.com
# 2. Vá para Settings > API
# 3. Copie Project URL e anon public key
#

# =================================================
# SUPABASE CONFIGURATION
# =================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# =================================================
# SERVER CONFIGURATION  
# =================================================
PORT=3000
NODE_ENV=development

# =================================================
# PRODUCTION ONLY (para deploy no Render)
# =================================================
# NODE_ENV=production
# PORT=(será definido automaticamente pelo Render)